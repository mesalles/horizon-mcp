# Copy to .env and fill in. The .env file is git-ignored; never commit real values.

# REQUIRED. Shown in the HORIZON web UI: user menu (top right) > "Mi perfil" > "Información".
HORIZON_API_KEY=

# Optional. Defaults shown.
# HORIZON_API_URL=https://api.horizon.delta90.com
# HORIZON_TIMEOUT=60            # seconds per request
# HORIZON_MIN_INTERVAL=0.5      # minimum seconds between two requests to HORIZON
# HORIZON_MAX_ROWS=200          # default cap on rows returned by list tools (hard cap 1000)

# HORIZON is behind Cloudflare, which blocks the default User-Agent of HTTP libraries
# (error 1010). The built-in default identifies this project and is verified to pass.
# A browser-like value is also known to work if the default ever gets blocked:
# HORIZON_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/128.0 Safari/537.36
